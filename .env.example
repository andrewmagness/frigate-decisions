# Gemini Decisions API. Use a key from a dedicated Google Cloud project so its
# quota is separate from other Gemini usage (rate limits are per project).
GEMINI_API_KEY=
# Optional: route through a proxy (e.g. a LiteLLM Gemini pass-through route).
# The client POSTs to {GEMINI_BASE_URL}/v1beta/decisions.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_AUTH_HEADER=x-goog-api-key
# DECISION_MODEL=gemini-decision-1

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# FRIGATE_TOPIC_PREFIX=frigate
# TOPIC_PREFIX=frigate/decisions
# DISCOVERY_PREFIX=homeassistant

# Frigate API. The unauthenticated internal port (5000) is simplest; for the
# authenticated port set FRIGATE_TOKEN to a JWT.
FRIGATE_URL=http://frigate:5000
# FRIGATE_TOKEN=
# FRIGATE_VERIFY_SSL=true

QUESTIONS_FILE=/config/questions.yaml
TZ=UTC
LOG_LEVEL=INFO
