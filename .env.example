# Decisions API provider: gemini (default) | openai | systemone
#   gemini     Google Gemini Decisions  (gemini-decision-1)
#   openai     OpenAI Decisions         (gpt-6-luna)
#   systemone  TypeSafe Jev, or any gateway with the same format, e.g. OpenRouter
DECISIONS_PROVIDER=gemini
# API key for the chosen provider. For gemini, GEMINI_API_KEY also works.
# Tip: use a dedicated project/key - rate limits are usually per project.
DECISIONS_API_KEY=
# Optional overrides (each provider has sensible defaults):
# DECISION_MODEL=gemini-decision-1
# DECISIONS_BASE_URL=https://generativelanguage.googleapis.com
# DECISIONS_PATH=/v1beta/decisions
# GEMINI_AUTH_HEADER=x-goog-api-key      # gemini only, e.g. for a proxy
#
# OpenRouter (routes to Jev, Solar Decide, and other decision models):
# DECISIONS_PROVIDER=systemone
# DECISIONS_BASE_URL=https://openrouter.ai/api
# DECISIONS_PATH=/alpha/decisions
# DECISION_MODEL=typesafe/jev-1.14

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# FRIGATE_TOPIC_PREFIX=frigate
# TOPIC_PREFIX=frigate/decisions
# DISCOVERY_PREFIX=homeassistant

# Frigate API. The unauthenticated internal port (5000) is simplest; for the
# authenticated port set FRIGATE_TOKEN to a JWT.
FRIGATE_URL=http://frigate:5000
# FRIGATE_TOKEN=
# FRIGATE_VERIFY_SSL=true

QUESTIONS_FILE=/config/questions.yaml
TZ=UTC
LOG_LEVEL=INFO

# Optional: record every decision and every 👍/👎 vote (from {TOPIC_PREFIX}/feedback)
# to JSONL files in this directory, for frigate-decisions-report. Mount it as a volume.
# DATA_DIR=/data
